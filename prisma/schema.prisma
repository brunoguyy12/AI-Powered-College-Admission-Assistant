// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("NEON_DATABASE_URL")
}

// User model for both students and admins
model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  role      UserRole   @default(STUDENT)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Student-specific fields
  studentProfile StudentProfile?
  applications   Application[]
  recommendations Recommendation[]

  // Admin-specific fields
  managedUniversities University[] @relation("AdminManaged")
  partnerships        Partnership[] @relation("AdminPartner")

  @@index([email])
  @@index([role])
}

enum UserRole {
  STUDENT
  ADMIN
}

// Student Profile
model StudentProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Education Level
  educationLevel    String   @default("undergraduate") // "undergraduate" or "masters"
  
  // Academic Information - Undergraduate
  gpa               Float?
  satScore          Int?
  actScore          Int?
  toeflScore        Int?
  ieltsScore        Float?
  
  // Academic Information - Masters
  greScore          Int?    // GRE score (for masters)
  gmatScore         Int?    // GMAT score (for masters)
  greQuantitative   Int?    // GRE Quantitative
  greVerbal         Int?    // GRE Verbal
  
  // Personal Information
  country           String?
  state             String?
  highSchool        String?  // For undergrad
  university        String?  // For masters
  graduationYear    Int?
  
  preferredStudyCountry String?
  budgetMin         Float?
  budgetMax         Float?
  
  // Interests
  majorInterests    String[]
  careerGoals       String?
  
  // Financial
  needsFinancialAid Boolean @default(false)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

// University Model
model University {
  id                String   @id @default(cuid())
  name              String   @unique
  country           String
  state             String?
  city              String
  
  location          String?  // "New York, USA" format
  adminEmail        String?  // Admin contact email (not visible to students)
  adminPhone        String?  // Admin contact phone (not visible to students)
  websiteUrl        String?  // University website
  
  documentsNeeded   String[] // ["Passport", "Transcript", "Birth Certificate"]
  applicationFee    Float?   // Application fee in USD
  requirementsSummary String? // Brief summary of requirements
  
  // Academic Information
  acceptanceRate    Float?
  averageGPA        Float?
  averageSAT        Int?
  averageACT        Int?
  
  // Program Information
  programs          Program[]
  
  // Rankings
  worldRanking      Int?
  nationalRanking   Int?
  
  // Financial
  tuitionFee        Float?
  averageAid        Float?
  
  // Admin Management
  adminId           String?
  admin             User?    @relation("AdminManaged", fields: [adminId], references: [id])
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([name])
  @@index([country])
  @@index([adminId])
}

// Program Model
model Program {
  id                String   @id @default(cuid())
  universityId      String
  university        University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  
  name              String
  degree            String   // Bachelor, Master, PhD
  field             String   // Computer Science, Business, etc.
  duration          Int      // in years
  
  // Requirements
  minGPA            Float?
  minSAT            Int?
  minACT            Int?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([universityId, name, degree])
  @@index([universityId])
}

// Application Model
model Application {
  id                String   @id @default(cuid())
  studentId         String
  student           User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  universityName    String
  programName       String
  degree            String
  
  statementOfPurpose String?
  essayTopic        String?
  essayContent      String?
  additionalEssays  String[] // Multiple essay responses
  
  status            ApplicationStatus @default(DRAFT)
  
  adminNotes        String?
  adminLastUpdated  DateTime?
  
  applicationDate   DateTime?
  deadline          DateTime?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([studentId])
  @@index([status])
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WAITLISTED
}

// Recommendation Model
model Recommendation {
  id                String   @id @default(cuid())
  studentId         String
  student           User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  universityName    String
  recommendedPrograms String[]
  matchScore        Float    // 0-100 score
  
  reasoning         String?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([studentId])
}

// Chat History for AI Assistant
model ChatMessage {
  id                String   @id @default(cuid())
  studentId         String?
  
  role              String   // "user" or "assistant"
  content           String
  
  createdAt         DateTime @default(now())

  @@index([studentId])
  @@index([createdAt])
}

// Notification Model
model Notification {
  id                String   @id @default(cuid())
  userId            String   // Student or Admin ID
  
  type              String   // "APPLICATION_SUBMITTED", "STATUS_CHANGED", "PARTNERSHIP_REQUEST", etc.
  title             String
  message           String
  
  applicationId     String?  // Reference to application (if relevant)
  partnershipId     String?  // Reference to partnership (if relevant)
  
  isRead            Boolean  @default(false)
  actionUrl         String?  // URL to view details
  
  createdAt         DateTime @default(now())
  readAt            DateTime?

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// Partnership Request Model
model Partnership {
  id                String   @id @default(cuid())
  
  universityName    String
  universityEmail   String
  universityPhone   String?
  contactPerson     String?
  
  adminId           String
  admin             User     @relation("AdminPartner", fields: [adminId], references: [id], onDelete: Cascade)
  
  status            String   @default("DRAFT") // "DRAFT", "SENT", "ACCEPTED", "REJECTED", "NEGOTIATING"
  
  emailSubject      String?
  emailContent      String   // Beautiful partnership proposal email
  
  requestDate       DateTime @default(now())
  sentDate          DateTime?
  responseDate      DateTime?
  
  responseMessage   String?  // University's response
  
  notes             String?  // Admin's internal notes
  followUpDate      DateTime? // Scheduled follow-up
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([adminId])
  @@index([status])
}

// Extend User model with partnership relation
// Partnership is now related to User via adminId
